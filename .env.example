# OpenCrawl Configuration
# Server
PORT=3000
HOST=0.0.0.0

# API Key - change this in production!
API_KEY=opencrawl-dev-key-change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting (requests per minute per API key)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Scrape Settings
SCRAPE_TIMEOUT=30000
SCRAPE_WAIT_FOR=0
SCRAPE_ONLY_MAIN_CONTENT=true
SCRAPE_BLOCK_ADS=true

# Crawl Settings
CRAWL_MAX_DEPTH=10
CRAWL_MAX_PAGES=100
CRAWL_MAX_CONCURRENCY=5
CRAWL_DELAY=1000

# Browser Settings
BROWSER_HEADLESS=true
BROWSER_LAUNCH_TIMEOUT=30000

# LLM Settings (for JSON structured extraction)
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Search Settings
SEARCH_PROVIDER=google
SEARXNG_URL=

# Logging
LOG_LEVEL=info
